# LLM Budget Manager — переменные окружения (12_plan.md §8).
# Скопируйте в deploy/.env и заполните пустые секреты: cp deploy/.env.example deploy/.env
# deploy/.env в git не попадает. Пустой обязательный секрет — сервис не стартует (так задумано).
# Генерация секретов: openssl rand -hex 32 (hex — без символов, которые ломают URL и shell).
#
# Секреты в docker compose (make up) передаются ФАЙЛАМИ: значения ниже compose кладёт в /run/secrets/<имя>
# контейнера, а приложение читает их через <ИМЯ>_FILE. В окружении процессов и в `docker inspect` их нет.
# Секреты: POSTGRES_PASSWORD, SESSION_SECRET, ADMIN_INITIAL_PASSWORD, ANTHROPIC_ADMIN_KEY, OPENAI_ADMIN_KEY,
# IMPORT_HTTPS_PROXY.
# Без compose (свой запуск процессов) можно задать <ИМЯ>_FILE=/путь/к/файлу — он имеет приоритет над <ИМЯ>.

# ---------- База данных ----------
# Пароль пользователя bm в контейнере postgres. Сгенерируйте: openssl rand -base64 32
POSTGRES_PASSWORD=
# Строка подключения БЕЗ пароля. Пусто — встроенный postgres из compose: postgresql://bm@postgres:5432/bm,
# пароль берётся из POSTGRES_PASSWORD (файлом). Внешний PostgreSQL: postgresql://bm@<хост>:5432/bm
# и его пароль в POSTGRES_PASSWORD.
DATABASE_URL=

# ---------- HTTP ----------
# Адрес, на котором опубликован API на хосте. 127.0.0.1 — только локально; 0.0.0.0 — для всей сети.
BIND_ADDR=127.0.0.1
# Порт API на хосте (внутри контейнера всегда 8080).
API_PORT=8080
# Число процессов uvicorn в контейнере api (эталонный стенд 4 vCPU — 2).
UVICORN_WORKERS=2

# ---------- Админка и вход ----------
# Ключ подписи сессий админки (не короче 16 символов). Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
# Флаг Secure у cookie сессии админки.
# false — по умолчанию: API слушает BIND_ADDR по HTTP, и браузер не вернул бы cookie с Secure.
# true — если админка открыта через HTTPS (обратный прокси заказчика перед API).
SESSION_COOKIE_SECURE=false
# Первый администратор создаётся при первом запуске; пароль нужно сменить при первом входе.
ADMIN_INITIAL_LOGIN=admin
ADMIN_INITIAL_PASSWORD=

# ---------- Решения (Decision API) ----------
# Срок жизни резерва без отчёта, минут; по истечении резерв списывается по оценке (флаг no_report).
RESERVATION_TTL_MIN=15
# Рекомендуемый таймаут клиента, мс (принцип III). Отдаётся клиентам в конфигурации.
DECISION_TIMEOUT_MS=50
# Поведение клиента при недоступности утилиты по умолчанию: open (пропустить) | closed (отказать).
DEFAULT_FAIL_MODE=open

# ---------- Импорт расхода провайдеров (единственный исходящий трафик, принцип IV) ----------
# false — исходящих соединений нет вообще. Включайте только после настройки ключей.
IMPORT_ENABLED=false
# Ключи администратора провайдеров (только для импорта расхода, получает только worker — файлом).
# Пусто — ключа нет (импорт этого провайдера не выполняется). Никогда не коммитьте ключи.
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
# Прокси для импорта расхода.
# пусто — прямой выход к API провайдеров (api.anthropic.com, api.openai.com);
# задайте http(s)://хост:порт, если выход только через корпоративный прокси.
# Действует только на импорт расхода при IMPORT_ENABLED=true (webhook и остальное идут без прокси);
# стандартные HTTP(S)_PROXY утилита игнорирует. Логин и пароль в URL (http://user:pass@хост:порт) — секрет:
# compose передаёт значение только worker и только файлом (/run/secrets/import_https_proxy через
# IMPORT_HTTPS_PROXY_FILE), в окружении контейнера и в `docker inspect` его нет.
IMPORT_HTTPS_PROXY=
# Час запуска импорта по МСК.
IMPORT_HOUR_MSK=4
# До какого часа МСК повторять импорт при ошибке.
IMPORT_RETRY_UNTIL_HOUR_MSK=12
# Сколько последних суток перечитывать при каждом импорте (поздние корректировки провайдера).
IMPORT_WINDOW_DAYS=7

# ---------- Уведомления ----------
# URL webhook во ВНУТРЕННЕЙ сети заказчика (10/8, 172.16/12, 192.168/16, 127/8). Пусто — канал выключен.
# Указывайте IP-адрес, а не имя хоста (docs/admin-guide.md, «Webhook»). 127/8 — это сам контейнер worker, не хост.
WEBHOOK_URL=
# Порог предупреждения о доле подписок в лимите подразделения, % (по умолчанию для новых подразделений).
SUBS_WARN_PCT_DEFAULT=50

# ---------- Хранение и резервные копии ----------
# Срок хранения детальных событий, месяцев (принцип I).
RETENTION_DETAIL_MONTHS=12
# Срок хранения агрегатов, месяцев.
RETENTION_AGG_MONTHS=36
# Сколько последних резервных копий хранить (контейнер backup делает копию при старте и раз в сутки).
BACKUP_KEEP=14

# ---------- Журналы ----------
# Уровень структурных логов (JSON): DEBUG | INFO | WARNING | ERROR. Содержимое запросов в логи не пишется.
LOG_LEVEL=INFO

# ---------- Проверки поставки (make smoke, make failover) ----------
# Пароль администратора ПОСЛЕ смены временного (не короче 12 символов). При первом входе make smoke сменит
# ADMIN_INITIAL_PASSWORD на этот пароль. Можно не хранить здесь, а передать: make smoke BM_ADMIN_PASSWORD=...
BM_ADMIN_PASSWORD=
