# LLM Budget Manager — переменные окружения (12_plan.md §8).
# Скопируйте в deploy/.env и заполните пустые секреты: cp deploy/.env.example deploy/.env
# deploy/.env в git не попадает. Пустой секрет — сервис не стартует (так задумано).
# Секреты можно передать файлом: переменная <ИМЯ>_FILE=/run/secrets/<файл> имеет приоритет над <ИМЯ>.

# ---------- База данных ----------
# Пароль пользователя bm в контейнере postgres. Сгенерируйте: openssl rand -base64 32
POSTGRES_PASSWORD=
# Полная строка подключения. В docker compose (T087) собирается из POSTGRES_PASSWORD автоматически;
# задавайте явно только при внешнем PostgreSQL: postgresql://bm:<пароль>@<хост>:5432/bm
DATABASE_URL=

# ---------- HTTP ----------
# Адрес, на котором опубликован API на хосте. 127.0.0.1 — только локально; 0.0.0.0 — для всей сети.
BIND_ADDR=127.0.0.1
# Порт API на хосте (внутри контейнера всегда 8080).
API_PORT=8080
# Число процессов uvicorn в контейнере api (эталонный стенд 4 vCPU — 2).
UVICORN_WORKERS=2

# ---------- Админка и вход ----------
# Ключ подписи сессий админки. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
# Первый администратор создаётся при первом запуске; пароль нужно сменить при первом входе.
ADMIN_INITIAL_LOGIN=admin
ADMIN_INITIAL_PASSWORD=

# ---------- Решения (Decision API) ----------
# Срок жизни резерва без отчёта, минут; по истечении резерв списывается по оценке (флаг no_report).
RESERVATION_TTL_MIN=15
# Рекомендуемый таймаут клиента, мс (принцип III). Отдаётся клиентам в конфигурации.
DECISION_TIMEOUT_MS=50
# Поведение клиента при недоступности утилиты по умолчанию: open (пропустить) | closed (отказать).
DEFAULT_FAIL_MODE=open

# ---------- Импорт расхода провайдеров (единственный исходящий трафик, принцип IV) ----------
# false — исходящих соединений нет вообще. Включайте только после настройки ключей.
IMPORT_ENABLED=false
# Ключи администратора провайдеров (только для импорта расхода, читает только worker).
# Предпочтительно передавать файлом через *_FILE. Никогда не коммитьте ключи.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY_FILE=
OPENAI_ADMIN_KEY=
OPENAI_ADMIN_KEY_FILE=
# Час запуска импорта по МСК.
IMPORT_HOUR_MSK=4
# До какого часа МСК повторять импорт при ошибке.
IMPORT_RETRY_UNTIL_HOUR_MSK=12
# Сколько последних суток перечитывать при каждом импорте (поздние корректировки провайдера).
IMPORT_WINDOW_DAYS=7

# ---------- Уведомления ----------
# URL webhook во ВНУТРЕННЕЙ сети заказчика. Пусто — канал выключен.
WEBHOOK_URL=
# Порог предупреждения о доле подписок в лимите подразделения, % (по умолчанию для новых подразделений).
SUBS_WARN_PCT_DEFAULT=50

# ---------- Хранение и резервные копии ----------
# Срок хранения детальных событий, месяцев (принцип I).
RETENTION_DETAIL_MONTHS=12
# Срок хранения агрегатов, месяцев.
RETENTION_AGG_MONTHS=36
# Сколько последних резервных копий хранить.
BACKUP_KEEP=14

# ---------- Журналы ----------
# Уровень структурных логов (JSON): DEBUG | INFO | WARNING | ERROR. Содержимое запросов в логи не пишется.
LOG_LEVEL=INFO
